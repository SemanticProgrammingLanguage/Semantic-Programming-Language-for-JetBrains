se 1

# Complete Semantic syntax-highlighting showcase
program Showcase
object Main

ranges {
    1-10
    20 - 42
}

types {
    @1
    @42
}

scope demo {
    node example
    relations

    true
    false
    null
    unknown

    %12
    %999
    @42

    "Hello Semantic"
    "Escaped: \"quoted\""

    123
    3.14159
    6.02e23
    0xFF

    list [1, 2, 3]
    object -> @42
}
